# ARI optional local path overrides.
# Copy to .env only if your launcher imports .env values into the process
# environment. Phase 3 does not load .env automatically.
#
# Do not add blank model or endpoint settings here: when loaded, an empty
# value can override the process configuration required by ARI.

# Optional private/deployed vault.
# Unset: ARI uses the default repository path src/data/db/ari.db.
ARI_DATABASE_PATH=

# Optional private system prompt.
# Unset: ARI uses the configured generic repository prompt.
ARI_SYSTEM_PROMPT_FILE=
